---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustBand from '../components/TrustBand.astro';
import Industries from '../components/Industries.astro';
import Courses from '../components/Courses.astro';
import CourseSets from '../components/CourseSets.astro';
import Why from '../components/Why.astro';
import Steps from '../components/Steps.astro';
import Reviews from '../components/Reviews.astro';
import Area from '../components/Area.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <TopBar />
  <Nav />
  <Hero />
  <TrustBand />
  <Industries />
  <Courses />
  <CourseSets />
  <Why />
  <Steps />
  <Reviews />
  <Area />
  <CTA />
  <Footer />
</Layout>

<script>
  // Reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('in'), (i % 3) * 80);
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // ECG animation with visibility pause
  const ecg = document.getElementById('ecgline');
  if (ecg) {
    const pathEl = ecg as unknown as SVGPathElement;
    const len = pathEl.getTotalLength();
    pathEl.style.strokeDasharray = String(len);
    let off = len;
    let animId = 0;

    function tick() {
      off -= len / 120;
      if (off <= 0) off = len;
      pathEl.style.strokeDashoffset = String(off);
      animId = requestAnimationFrame(tick);
    }

    if (!document.hidden) {
      animId = requestAnimationFrame(tick);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(animId);
      } else {
        animId = requestAnimationFrame(tick);
      }
    });
  }

</script>
